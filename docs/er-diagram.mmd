    users {
        bigint id PK
        varchar email UK
        varchar password_hash
        varchar status
        int failed_attempts
    }
    products {
        bigint id PK
        varchar sku UK
        numeric price
        bool active
    }
    inventory {
        bigint product_id PK
        int quantity "never below 0"
        int low_stock_threshold
    }
    orders {
        bigint id PK
        varchar order_number UK
        varchar status
        numeric total
        varchar idempotency_key "unique per user"
    }
    order_items {
        bigint id PK
        varchar sku "snapshot"
        varchar name "snapshot"
        numeric unit_price "snapshot"
        int quantity
    }
    payments {
        bigint id PK
        varchar reference
        varchar status
        bool simulated
    }
